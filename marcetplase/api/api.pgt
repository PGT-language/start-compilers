function(publish_plugin) {
    body + string = request::body()
    if (body == "") {
        return json::object("error", "empty request body")
    }
    payload + object = json::parse(body)
    if (json::stringify(json::get(payload, "token")) == "null") {
        return json::object("error", "auth required")
    }
    if (json::stringify(json::get(payload, "plugin_json")) == "null") {
        return json::object("error", "plugin json is required")
    }
    if (json::stringify(json::get(payload, "owner_email")) == "null") {
        return json::object("error", "owner email is required")
    }
    token + string = json::get(payload, "token")
    plugin_text + string = json::get(payload, "plugin_json")
    owner_email + string = json::get(payload, "owner_email")
    if (token == "") {
        return json::object("error", "auth required")
    }
    if (plugin_text == "") {
        return json::object("error", "plugin json is required")
    }
    if (owner_email == "") {
        return json::object("error", "owner email is required")
    }
    if (jwt::verify(token, "marketplace-dev-secret-change-me")) {
        owner + object = orm::find("User", "email", owner_email)
        if (json::stringify(owner) == "{}") {
            return json::object("error", "auth required")
        }
        plugin + object = json::parse(plugin_text)
        save(json::object(
            "owner_email", owner_email,
            "name", json::get(plugin, "name"),
            "slug", json::get(plugin, "slug"),
            "version", json::get(plugin, "version"),
            "manifest_json", plugin_text,
            "created_at", json::get(plugin, "submitted_at")
        ))
        return json::object("status", "uploaded")
    }
    return json::object("error", "auth required")
    return 1
}
