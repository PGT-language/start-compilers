function(plugin_slot, id + int) {
    plugin + object = orm::find("Plugin", "id", id)
    if (json::stringify(plugin) == "{}") {
        return ""
    }
    if (json::stringify(json::get(plugin, "manifest_json")) == "null") {
        return ""
    }
    manifest_json + string = json::get(plugin, "manifest_json")
    return manifest_json
    return 1
}

